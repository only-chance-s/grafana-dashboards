{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "tempo-service-graph-manual"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations \u0026 Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "tempo",
                      "kind": "DataQuery",
                      "spec": {
                        "queryType": "serviceMap"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Visualizes the relationship between services based on traces. Requires Tempo Metrics Generator.",
          "id": 1,
          "links": [],
          "title": "Service Graph (Tempo)",
          "vizConfig": {
            "group": "nodeGraph",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "edges": {
                  "mainStatUnit": "s",
                  "secondaryStatUnit": "rps"
                },
                "layoutAlgorithm": "layered",
                "nodes": {
                  "mainStatUnit": "rps",
                  "secondaryStatUnit": "ms"
                },
                "zoomMode": "cooperative"
              }
            },
            "version": "13.2.4"
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-1"
              },
              "height": 29,
              "width": 24,
              "x": 0,
              "y": 0
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [
      "tempo",
      "service-graph"
    ],
    "timeSettings": {
      "autoRefresh": "1m",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "fiscalYearStartMonth": 0,
      "from": "now-1h",
      "hideTimepicker": false,
      "timezone": "browser",
      "to": "now"
    },
    "title": "Manual Service Graph (Tempo)",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "Tempo",
            "value": "Tempo"
          },
          "hide": "dontHide",
          "includeAll": false,
          "label": "Datasource",
          "multi": false,
          "name": "datasource",
          "options": [],
          "pluginId": "tempo",
          "refresh": "onDashboardLoad",
          "regex": "",
          "skipUrlSync": false
        }
      }
    ]
  }
}