{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "tempo",
        "uid": "${datasource}"
      },
      "description": "Real HTTP requests to the API services and the database, Redis and Keycloak calls they make. Excludes health probes, WebSocket sessions and background work (traffic.class=api).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${datasource}"
          },
          "queryType": "serviceMap",
          "refId": "A",
          "serviceMapQuery": [
            "{server_traffic_class=\"api\"}",
            "{client_traffic_class=\"api\"}"
          ]
        }
      ],
      "title": "API traffic",
      "type": "nodeGraph"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Requests per second per route for real API traffic only (traffic.class=api). Probes, WebSocket sessions and background work are excluded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "id": 6,
      "interval": "2m",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (service, span_name) (rate(traces_spanmetrics_calls_total{traffic_class=\"api\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{span_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "API request rate by route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Share of requests per route whose server span ended in error: 5xx responses and unhandled exceptions. 4xx responses such as 401 are not errors here. Shows 0% when a route had traffic but no errors.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "id": 7,
      "interval": "2m",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "(sum by (service, span_name) (rate(traces_spanmetrics_calls_total{traffic_class=\"api\", span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or sum by (service, span_name) (rate(traces_spanmetrics_calls_total{traffic_class=\"api\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) * 0) / (sum by (service, span_name) (rate(traces_spanmetrics_calls_total{traffic_class=\"api\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) > 0) * 100",
          "legendFormat": "{{service}} {{span_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "API error rate by route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "95th percentile server latency per route for real API traffic only (traffic.class=api), from Tempo span metrics.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "id": 8,
      "interval": "2m",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service, span_name) (rate(traces_spanmetrics_latency_bucket{traffic_class=\"api\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "{{service}} {{span_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "API p95 latency by route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${datasource}"
      },
      "description": "Long-lived WebSocket connections. Durations are session lengths, not request latency (traffic.class=realtime).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "id": 2,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${datasource}"
          },
          "queryType": "serviceMap",
          "refId": "A",
          "serviceMapQuery": [
            "{server_traffic_class=\"realtime\"}",
            "{client_traffic_class=\"realtime\"}"
          ]
        }
      ],
      "title": "Realtime: WebSocket sessions",
      "type": "nodeGraph"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${datasource}"
      },
      "description": "Taskiq workers, scheduled jobs and API background loops. Blocking queue reads make Redis latency high by design (traffic.class=worker, job, background).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "id": 3,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${datasource}"
          },
          "queryType": "serviceMap",
          "refId": "A",
          "serviceMapQuery": [
            "{server_traffic_class=~\"worker|job|background\"}",
            "{client_traffic_class=~\"worker|job|background\"}"
          ]
        }
      ],
      "title": "Background: workers, CronJobs, in-process loops",
      "type": "nodeGraph"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${datasource}"
      },
      "description": "Kubelet liveness and readiness checks plus the external health check, including the database and Redis calls they make (traffic.class=probe).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "id": 4,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${datasource}"
          },
          "queryType": "serviceMap",
          "refId": "A",
          "serviceMapQuery": [
            "{server_traffic_class=\"probe\"}",
            "{client_traffic_class=\"probe\"}"
          ]
        }
      ],
      "title": "Health probes",
      "type": "nodeGraph"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${datasource}"
      },
      "description": "Services that do not set traffic.class, such as Grafana and its datasources, Keycloak and Loki.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "id": 5,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${datasource}"
          },
          "queryType": "serviceMap",
          "refId": "A",
          "serviceMapQuery": [
            "{client_traffic_class=\"\", server_traffic_class=\"\"}"
          ]
        }
      ],
      "title": "Platform: Grafana, Keycloak, observability",
      "type": "nodeGraph"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "tempo",
    "service-graph"
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "description": "Deployment environment. Workload selectors are built from it as <env>-ns, <env>-api and so on, matching baseConfig.environment in only-chance-devops. Add prod here when it exists.",
        "query": "staging",
        "current": {
          "selected": true,
          "text": "staging",
          "value": "staging"
        },
        "options": [
          {
            "selected": true,
            "text": "staging",
            "value": "staging"
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      },
      {
        "current": {
          "selected": false,
          "text": "Tempo",
          "value": "Tempo"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "tempo",
        "refresh": 1,
        "regex": "",
