        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Manual Service Graph (Tempo)",
  "uid": "tempo-service-graph-manual",
  "version": 1,
  "weekStart": "",
