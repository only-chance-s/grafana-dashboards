        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (server) (pg_database_size_bytes{server=~\"$server\"})",
          "legendFormat": "",
          "refId": "F",
          "range": false,
